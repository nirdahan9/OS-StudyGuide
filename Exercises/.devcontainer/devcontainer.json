{
    "name": "Ubuntu 24.04 C/C++ (x86_64)",
    "image": "ubuntu:24.04",
    "runArgs": [
        "--platform=linux/amd64",
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack"
            ]
        }
    },
    "postCreateCommand": "apt-get update && apt-get install -y build-essential gdb gcc-13"
}