<!DOCTYPE html>
<html dir="rtl" lang="he"><head><meta charset="utf-8"/><meta content="width=device-width,initial-scale=1" name="viewport"/><title>מערכות הפעלה — מדריך למידה למבחן</title></head><body>
<style>
*,*::before,*::after{box-sizing:border-box}
:root{
  --bg:#F5F6F8; --surface:#FFFFFF; --surface-2:#EFF1F5; --ink:#10161F; --muted:#5A6675;
  --line:#DDE2E9; --line-soft:#E9EDF3; --code-bg:#EDF0F5;
  --accent:#2F5FD0; --accent-soft:#2F5FD014; --accent-line:#2F5FD033;
  --ok:#0E7C5A; --ok-soft:#0E7C5A14; --bad:#C0343C; --bad-soft:#C0343C14;
  --warn:#B4741A; --warn-soft:#B4741A16;
  --lec:#6D3FD1; --lec-soft:#6D3FD10F; --lec-line:#6D3FD133;
  --radius:10px; --shadow:0 1px 2px rgba(16,22,31,.05),0 6px 18px rgba(16,22,31,.05);
  --mono:ui-monospace,"SF Mono",SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;
  --sans:system-ui,-apple-system,"Segoe UI",Rubik,Arial,sans-serif;
}
@media (prefers-color-scheme:dark){
  :root{
    --bg:#0E1116; --surface:#161B23; --surface-2:#1D232D; --ink:#E8ECF2; --muted:#97A1AF;
    --line:#262E3A; --line-soft:#1F2630; --code-bg:#1B222C;
    --accent:#7DA2F0; --accent-soft:#7DA2F014; --accent-line:#7DA2F033;
    --ok:#4FBE94; --ok-soft:#4FBE9414; --bad:#F0797F; --bad-soft:#F0797F14;
    --warn:#E0A94E; --warn-soft:#E0A94E16;
    --lec:#B49BF0; --lec-soft:#B49BF012; --lec-line:#B49BF033;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 6px 18px rgba(0,0,0,.3);
  }
}
:root[data-theme="dark"]{
  --bg:#0E1116; --surface:#161B23; --surface-2:#1D232D; --ink:#E8ECF2; --muted:#97A1AF;
  --line:#262E3A; --line-soft:#1F2630; --code-bg:#1B222C;
  --accent:#7DA2F0; --accent-soft:#7DA2F014; --accent-line:#7DA2F033;
  --ok:#4FBE94; --ok-soft:#4FBE9414; --bad:#F0797F; --bad-soft:#F0797F14;
  --warn:#E0A94E; --warn-soft:#E0A94E16;
  --lec:#B49BF0; --lec-soft:#B49BF012; --lec-line:#B49BF033;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 6px 18px rgba(0,0,0,.3);
}
:root[data-theme="light"]{
  --bg:#F5F6F8; --surface:#FFFFFF; --surface-2:#EFF1F5; --ink:#10161F; --muted:#5A6675;
  --line:#DDE2E9; --line-soft:#E9EDF3; --code-bg:#EDF0F5;
  --accent:#2F5FD0; --accent-soft:#2F5FD014; --accent-line:#2F5FD033;
  --ok:#0E7C5A; --ok-soft:#0E7C5A14; --bad:#C0343C; --bad-soft:#C0343C14;
  --warn:#B4741A; --warn-soft:#B4741A16;
  --lec:#6D3FD1; --lec-soft:#6D3FD10F; --lec-line:#6D3FD133;
  --shadow:0 1px 2px rgba(16,22,31,.05),0 6px 18px rgba(16,22,31,.05);
}

.osx{direction:rtl;background:var(--bg);color:var(--ink);font-family:var(--sans);
  font-size:16px;line-height:1.72;-webkit-font-smoothing:antialiased}
.osx :where(h1,h2,h3,h4){text-wrap:balance;line-height:1.25;margin:0}
.osx p{margin:0}
.wrap{display:grid;grid-template-columns:238px minmax(0,1fr);gap:2.4rem;
  max-width:1260px;margin:0 auto;padding:0 1.4rem}
.rail{position:sticky;top:1.2rem;align-self:start;max-height:calc(100vh - 2.4rem);overflow-y:auto;
  padding:1.4rem 0 3rem;font-size:.85rem;scrollbar-width:thin}
.grp{margin-bottom:1.15rem}
.grp>span{display:block;font-weight:800;letter-spacing:.05em;font-size:.68rem;color:var(--muted);
  text-transform:uppercase;margin-bottom:.35rem;padding-inline-start:.6rem;
  border-inline-start:3px solid var(--gc,var(--line))}
.rail a{display:block;color:var(--ink);text-decoration:none;padding:.19rem .6rem;
  border-inline-start:3px solid transparent;line-height:1.45}
.rail a:hover{border-inline-start-color:var(--gc,var(--muted));background:var(--surface)}
.rail a.on{border-inline-start-color:var(--gc,var(--accent));background:var(--surface);font-weight:700}
.rail .btn{margin-inline-start:.6rem;margin-top:.3rem}
main{min-width:0;padding:0 0 6rem}
@media(max-width:1080px){.wrap{grid-template-columns:minmax(0,1fr);gap:0}.rail{display:none}
  main{padding:0 0 4rem}}

.hero{padding:3.2rem 0 2rem;border-bottom:1px solid var(--line)}
.kicker{font-family:var(--mono);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);font-weight:600}
.hero h1{font-size:clamp(1.9rem,4.4vw,2.9rem);font-weight:800;letter-spacing:-.02em;margin:.6rem 0 .7rem}
.lede{color:var(--muted);font-size:1.04rem;max-width:60ch}
.stats{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.5rem}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:.3rem .8rem;
  font-size:.8rem;color:var(--muted);font-variant-numeric:tabular-nums}
.stat b{color:var(--ink);font-weight:700}

section{padding-top:3rem}
.sec-h{display:flex;align-items:baseline;gap:.7rem;flex-wrap:wrap;margin-bottom:.5rem}
.sec-h h2{font-size:1.5rem;font-weight:800;letter-spacing:-.01em}
.sec-sub{color:var(--muted);font-size:.94rem;max-width:66ch;margin-bottom:1.3rem}

.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
  padding:1.3rem 1.4rem;box-shadow:var(--shadow);margin-bottom:1rem}
.card>*+*{margin-top:.85rem}

/* exam logistics */
.alert{border-radius:var(--radius);padding:1.2rem 1.3rem;border:1px solid var(--bad);
  background:var(--bad-soft);margin-bottom:1rem}
.alert h3{font-size:1.05rem;font-weight:800;color:var(--bad);margin-bottom:.35rem}
.lg{display:grid;gap:.6rem}
.lg-row{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:.75rem .9rem}
.lg-row.critical{border-color:var(--bad);background:var(--bad-soft)}
.lg-row.warn{border-color:var(--warn);background:var(--warn-soft)}
.lg-k{font-weight:800;font-size:.9rem;margin-bottom:.2rem}
.lg-v{font-size:.92rem}
.q-src{font-family:var(--mono);font-size:.72rem;color:var(--muted);margin-top:.4rem;
  padding-inline-start:.6rem;border-inline-start:2px solid var(--line)}
.q-src i{display:block;font-style:italic;color:var(--ink);opacity:.75;margin-bottom:.15rem}

/* woven inline quote — the lecturer's own phrasing, integrated (no provenance label) */
.unit q{font-style:italic;quotes:"„" "”" "‚" "’"}
.unit q::before{content:open-quote}
.unit q::after{content:close-quote}
.unit blockquote{margin:.7rem 0;padding:.15rem 0 .15rem .9rem;border-inline-start:3px solid var(--accent-line);
  color:var(--ink);font-style:italic}

/* parts + units */
.part{margin-top:2.6rem;padding-top:1.1rem;border-top:2px solid var(--ph)}
.part-k{font-family:var(--mono);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;
  color:var(--ph);font-weight:700}
.part h2{font-size:1.35rem;font-weight:800;margin:.25rem 0 .2rem}
.part-s{color:var(--muted);font-size:.9rem}
.unit{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
  padding:1.4rem 1.5rem;box-shadow:var(--shadow);margin:1rem 0}
.unit-h{display:flex;align-items:center;gap:.6rem;margin-bottom:.7rem;flex-wrap:wrap}
.unum{font-family:var(--mono);font-size:.72rem;font-weight:700;color:#fff;background:var(--ph);
  border-radius:5px;padding:.13rem .45rem}
.unit-h h3{font-size:1.16rem;font-weight:800}
.bonus{font-size:.68rem;font-weight:700;color:var(--warn);border:1px solid var(--warn);
  border-radius:999px;padding:.08rem .5rem}
.unit h4{font-size:.98rem;font-weight:800;margin:1.3rem 0 .45rem;padding-bottom:.28rem;
  border-bottom:1px solid var(--line-soft)}
.unit p{margin:.55rem 0}
.unit ul,.unit ol{margin:.55rem 0;padding-inline-start:1.25rem}
.unit li{margin:.28rem 0}
.unit table{width:100%;border-collapse:collapse;font-size:.88rem;margin:.7rem 0;
  font-variant-numeric:tabular-nums}
.unit th,.unit td{border:1px solid var(--line);padding:.42rem .6rem;text-align:start}
.unit th{background:var(--surface-2);font-weight:700}
.tbl{overflow-x:auto}
code{font-family:var(--mono);font-size:.87em;background:var(--code-bg);padding:.1em .35em;
  border-radius:4px;direction:ltr;display:inline-block}
pre{background:var(--code-bg);border:1px solid var(--line);border-radius:8px;padding:.85rem 1rem;
  overflow-x:auto;direction:ltr;text-align:left;font-size:.85rem;line-height:1.6}
pre code{background:none;padding:0}
.k{font-family:var(--mono);font-size:.87em;color:var(--accent);direction:ltr;display:inline-block}
.kp{background:var(--accent-soft);border:1px solid var(--accent-line);border-radius:8px;padding:.85rem 1rem}
.kp ul{margin:0;padding-inline-start:1.15rem}
.kp li{margin:.3rem 0;font-size:.92rem}
.pit{background:var(--warn-soft);border:1px solid var(--warn);border-radius:8px;padding:.85rem 1rem}
.pit ul{margin:0;padding-inline-start:1.15rem}
.pit li{margin:.3rem 0;font-size:.92rem}

/* MCQ */
.mbar{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap;background:var(--surface);
  border:1px solid var(--line);border-radius:var(--radius);padding:.7rem 1rem;margin-bottom:1rem;
  position:sticky;top:.6rem;z-index:5;box-shadow:var(--shadow)}
.mbar .sc{font-variant-numeric:tabular-nums;font-weight:700}
.btn{font:inherit;font-size:.82rem;font-weight:600;color:var(--ink);background:var(--surface-2);
  border:1px solid var(--line);border-radius:7px;padding:.32rem .8rem;cursor:pointer}
.btn:hover{border-color:var(--accent);color:var(--accent)}
.btn:focus-visible,.mopt:focus-visible,.rail a:focus-visible,summary:focus-visible{
  outline:2px solid var(--accent);outline-offset:2px}
.mset{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
  padding:1.2rem 1.3rem;margin-bottom:1rem;box-shadow:var(--shadow)}
.mset-h{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin-bottom:.9rem;
  padding-bottom:.6rem;border-bottom:1px solid var(--line-soft)}
.mset-h h3{font-size:1.04rem;font-weight:800;flex:1}
.cnt{font-family:var(--mono);font-size:.72rem;color:var(--muted)}
.mcq{padding:.9rem 0;border-top:1px solid var(--line-soft)}
.mcq:first-of-type{border-top:0}
.mq{font-weight:600;margin-bottom:.6rem;display:flex;gap:.5rem}
.qn{font-family:var(--mono);font-size:.75rem;color:var(--muted);flex:none;padding-top:.22rem;
  min-width:1.6rem}
.mopts{list-style:none;margin:0;padding:0;display:grid;gap:.35rem}
.mopt{display:flex;gap:.55rem;width:100%;text-align:start;font:inherit;font-size:.92rem;
  color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:8px;
  padding:.5rem .7rem;cursor:pointer}
.mopt:hover:not(:disabled){border-color:var(--accent);background:var(--accent-soft)}
.mopt:disabled{cursor:default}
.lt{font-family:var(--mono);font-size:.78rem;color:var(--muted);flex:none;padding-top:.1rem}
.mopt.right{border-color:var(--ok);background:var(--ok-soft)}
.mopt.right .lt{color:var(--ok);font-weight:700}
.mopt.wrong{border-color:var(--bad);background:var(--bad-soft)}
.mopt.wrong .lt{color:var(--bad);font-weight:700}
.mark{margin-inline-start:auto;font-weight:800;flex:none}
.mopt.right .mark::after{content:"✓";color:var(--ok)}
.mopt.wrong .mark::after{content:"✕";color:var(--bad)}
.why{margin-top:.6rem;background:var(--surface-2);border-inline-start:3px solid var(--accent);
  border-radius:0 8px 8px 0;padding:.65rem .85rem;font-size:.89rem}
.why b{color:var(--accent)}
.why .src{display:block;font-family:var(--mono);font-size:.7rem;color:var(--muted);margin-top:.35rem}

/* exams */
.exam{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
  padding:1.4rem 1.5rem;margin-bottom:1.1rem;box-shadow:var(--shadow)}
.exam-h{border-bottom:2px solid var(--accent);padding-bottom:.7rem;margin-bottom:1rem}
.exam-h h3{font-size:1.2rem;font-weight:800}
.meta{font-size:.85rem;color:var(--muted);margin-top:.4rem}
.meta b{color:var(--ink)}
.pt{font-family:var(--mono);font-size:.75rem;color:var(--muted);font-weight:600}
.pA{display:grid;gap:.5rem}
.tf{display:flex;gap:.6rem;align-items:flex-start;background:var(--surface-2);border-radius:8px;
  padding:.6rem .8rem;font-size:.93rem}
.tf .qn{padding-top:0}
.part-t{font-size:1rem;font-weight:800;margin:1.4rem 0 .6rem;color:var(--accent)}
.oq{border:1px solid var(--line);border-radius:8px;padding:1rem 1.1rem;margin:.7rem 0}
.oq h4{font-size:1rem;font-weight:800;margin-bottom:.5rem}
.oq table{width:100%;border-collapse:collapse;font-size:.87rem;margin:.6rem 0;font-variant-numeric:tabular-nums}
.oq th,.oq td{border:1px solid var(--line);padding:.38rem .55rem;text-align:start}
.oq th{background:var(--surface-2)}
.sub{margin-top:.8rem;padding-top:.6rem;border-top:1px dashed var(--line)}
.sub-h{font-weight:700;font-size:.9rem;display:flex;gap:.5rem;align-items:baseline}
details.sol{margin-top:.6rem;border:1px solid var(--ok);border-radius:8px;background:var(--ok-soft)}
details.sol>summary{cursor:pointer;padding:.5rem .8rem;font-weight:700;font-size:.87rem;color:var(--ok);
  list-style:none}
details.sol>summary::-webkit-details-marker{display:none}
details.sol>summary::before{content:"▸ ";display:inline-block;transition:transform .15s}
details.sol[open]>summary::before{transform:rotate(90deg)}
.sol-b{padding:0 .9rem .9rem;font-size:.9rem}
.sol-b p{margin:.5rem 0}
.sol-b ul,.sol-b ol{margin:.5rem 0;padding-inline-start:1.2rem}

.foot{margin-top:4rem;padding-top:1.5rem;border-top:1px solid var(--line);color:var(--muted);font-size:.83rem}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
@media print{.rail,.mbar,.btn{display:none}.wrap{grid-template-columns:1fr}
  details.sol{break-inside:avoid}.exam{break-after:page}}

/* language switch */
.osx[data-lang="en"]{direction:ltr}
</style>
<div class="osx" dir="rtl" id="osx" lang="he">
<div class="wrap">
<nav aria-label="ניווט" class="rail">
<div class="grp" style="--gc:var(--accent)"><span data-i18n="k0001">הקורס</span><a data-i18n="k0012" href="#top">ראשי</a><a data-i18n="k0013" href="#summary">הסיכום</a></div>
<div class="grp" style="--gc:#B4741A"><span data-i18n="k0002">חלק א — יסודות</span>
<a data-i18n="k0014" href="#u1">היסטוריה ותפקיד מערכת ההפעלה</a>
<a data-i18n="k0015" href="#u2">טרמינולוגיה וחשבון זמנים</a>
</div>
<div class="grp" style="--gc:#2F5FD0"><span data-i18n="k0003">חלק ב — תהליכונים וסנכרון</span>
<a data-i18n="k0016" href="#u3">אנטומיה של תהליך ותהליכון</a>
<a data-i18n="k0017" href="#u4">תנאי מרוץ והדרה הדדית</a>
<a data-i18n="k0018" href="#u5">מנעולים ופרימיטיבים לסנכרון</a>
<a data-i18n="k0019" href="#u6">יצרן-צרכן</a>
</div>
<div class="grp" style="--gc:#6D3FD1"><span data-i18n="k0004">חלק ג — גרעין, משתמש וסיגנלים</span>
<a data-i18n="k0020" href="#u7">מצב גרעין/משתמש וקריאות מערכת</a>
<a data-i18n="k0021" href="#u8">סיגנלים וטיפול בחריגות</a>
<a data-i18n="k0022" href="#u9">תהליכונים במרחב המשתמש</a>
</div>
<div class="grp" style="--gc:#0E7C5A"><span data-i18n="k0005">חלק ד — תזמון</span>
<a data-i18n="k0023" href="#u10">תזמון מעבד</a>
</div>
<div class="grp" style="--gc:#C0343C"><span data-i18n="k0006">חלק ה — זיכרון</span>
<a data-i18n="k0024" href="#u11">זיכרון פיזי והתפתחות ניהול הזיכרון</a>
<a data-i18n="k0025" href="#u12">זיכרון וירטואלי ותרגום כתובות</a>
<a data-i18n="k0026" href="#u13">דפדוף, טבלאות דפים ו-TLB</a>
<a data-i18n="k0027" href="#u14">החלפה והחלפת דפים</a>
</div>
<div class="grp" style="--gc:#0E6E86"><span data-i18n="k0007">חלק ו — מערכות קבצים ואחסון</span>
<a data-i18n="k0028" href="#u15">חומרת אחסון</a>
<a data-i18n="k0029" href="#u16">הקצאת קבצים וספריות</a>
<a data-i18n="k0030" href="#u17">אתחול, מחיצות וקושחה</a>
<a data-i18n="k0031" href="#u18">קישורים, מתארי קבצים וצינורות</a>
<a href="#u19">RAID</a>
</div>
<div class="grp" style="--gc:#A03A7A"><span data-i18n="k0008">חלק ז — הרצה ווירטואליזציה</span>
<a data-i18n="k0032" href="#u20">קבצי הרצה וקישור</a>
<a data-i18n="k0033" href="#u21">וירטואליזציה (נושא בונוס)</a>
</div>
<div class="grp" style="--gc:var(--accent)"><span data-i18n="k0009">שאלות אמריקאיות</span><a data-i18n="k0034" href="#mcq">כל השאלות (285)</a>
<a data-i18n="k0036" href="#q2">טרמינולוגיה וחשבון זמנים</a>
<a data-i18n="k0037" href="#q3">אנטומיה של תהליך ותהליכון</a>
<a data-i18n="k0038" href="#q4">תנאי מרוץ והדרה הדדית</a>
<a data-i18n="k0039" href="#q5">מנעולים ופרימיטיבים לסנכרון</a>
<a data-i18n="k0040" href="#q6">יצרן-צרכן</a>
<a data-i18n="k0041" href="#q7">מצב גרעין/משתמש וקריאות מערכת</a>
<a data-i18n="k0042" href="#q8">סיגנלים וטיפול בחריגות</a>
<a data-i18n="k0043" href="#q9">תהליכונים במרחב המשתמש</a>
<a data-i18n="k0044" href="#q10">תזמון מעבד</a>
<a data-i18n="k0045" href="#q11">זיכרון פיזי והתפתחות ניהול הזיכרון</a>
<a data-i18n="k0046" href="#q12">זיכרון וירטואלי ותרגום כתובות</a>
<a data-i18n="k0047" href="#q13">דפדוף, טבלאות דפים ו-TLB</a>
<a data-i18n="k0048" href="#q14">החלפה והחלפת דפים</a>
<a data-i18n="k0049" href="#q15">חומרת אחסון</a>
<a data-i18n="k0050" href="#q16">הקצאת קבצים וספריות</a>
<a data-i18n="k0051" href="#q17">אתחול, מחיצות וקושחה</a>
<a data-i18n="k0052" href="#q18">קישורים, מתארי קבצים וצינורות</a>
<a href="#q19">RAID</a>
<a data-i18n="k0053" href="#q20">קבצי הרצה וקישור</a>
</div><div class="grp" style="--gc:var(--accent)"><span data-i18n="tf_h2">שאלות נכון / לא נכון</span><a data-i18n="tf_navall" href="#tf">כל ההיגדים (95)</a><a data-i18n="k3628" href="#tf2">טרמינולוגיה וחשבון זמנים</a><a data-i18n="k3629" href="#tf3">אנטומיה של תהליך ותהליכון</a><a data-i18n="k3630" href="#tf4">תנאי מרוץ והדרה הדדית</a><a data-i18n="k3631" href="#tf5">מנעולים ופרימיטיבים לסנכרון</a><a data-i18n="k3632" href="#tf6">יצרן-צרכן</a><a data-i18n="k3633" href="#tf7">מצב גרעין/משתמש וקריאות מערכת</a><a data-i18n="k3634" href="#tf8">סיגנלים וטיפול בחריגות</a><a data-i18n="k3635" href="#tf9">תהליכונים במרחב המשתמש</a><a data-i18n="k3636" href="#tf10">תזמון מעבד</a><a data-i18n="k3637" href="#tf11">זיכרון פיזי והתפתחות ניהול הזיכרון</a><a data-i18n="k3638" href="#tf12">זיכרון וירטואלי ותרגום כתובות</a><a data-i18n="k3639" href="#tf13">דפדוף, טבלאות דפים ו-TLB</a><a data-i18n="k3640" href="#tf14">החלפה והחלפת דפים</a><a data-i18n="k3641" href="#tf15">חומרת אחסון</a><a data-i18n="k3642" href="#tf16">הקצאת קבצים וספריות</a><a data-i18n="k3643" href="#tf17">אתחול, מחיצות וקושחה</a><a data-i18n="k3644" href="#tf18">קישורים, מתארי קבצים וצינורות</a><a href="#tf19">RAID</a><a data-i18n="k3645" href="#tf20">קבצי הרצה וקישור</a></div>
<div class="grp" style="--gc:var(--ok)"><span data-i18n="k0010">מבחני תרגול</span>
<a data-i18n="k0055" href="#exam1">מבחן תרגול 1</a>
<a data-i18n="k0056" href="#exam2">מבחן תרגול 2</a>
<a data-i18n="k0057" href="#exam3">מבחן תרגול 3</a>
